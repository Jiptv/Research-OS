# Optional: use a prebuilt dashboard image instead of building locally.
# Example for GitHub Container Registry:
# RESEARCH_OS_IMAGE=ghcr.io/your-org/research-os-dashboard:latest

# Optional: override the timezone used inside the Docker container.
TZ=Europe/Amsterdam

# Optional: override the iCloud backup mount.
# RESEARCH_OS_ICLOUD_DIR=/Users/your.name/Library/Mobile Documents/com~apple~CloudDocs/iCloud/UX Research
# RESEARCH_OS_BACKUP_DIR=/icloud/UX Research
